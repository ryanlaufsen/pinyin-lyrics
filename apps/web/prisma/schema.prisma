generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SongLanguage {
  ZH
  JA
  KO
}

enum RomanizationStatus {
  PENDING
  COMPLETE
  FAILED
}

model Song {
  id              String      @id @default(cuid())
  title           String
  artist          String?
  language        SongLanguage
  sourceNote      String?
  rightsNote      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lines           LyricLine[]
  romanizationRuns RomanizationRun[]
}

model LyricLine {
  id        String   @id @default(cuid())
  songId    String
  position  Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  tokens    RomanizedToken[]

  @@unique([songId, position])
  @@index([songId])
}

model RomanizationRun {
  id            String              @id @default(cuid())
  songId        String
  language      SongLanguage
  system        String
  engineVersion String
  status        RomanizationStatus  @default(PENDING)
  errorMessage  String?
  createdAt     DateTime            @default(now())
  completedAt   DateTime?
  song          Song                @relation(fields: [songId], references: [id], onDelete: Cascade)
  tokens        RomanizedToken[]

  @@index([songId, status])
}

model RomanizedToken {
  id        String            @id @default(cuid())
  runId     String
  lineId    String?
  source    String
  reading   String
  start     Int
  end       Int
  confidence String
  run       RomanizationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  line      LyricLine?        @relation(fields: [lineId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([lineId])
}
