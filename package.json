{
  "name": "lyricbridge",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": ">=10.33.4"
  },
  "scripts": {
    "package-manager": "corepack pnpm@10.33.4 --version",
    "dev": "pnpm --filter @lyricbridge/web dev",
    "build": "pnpm --filter @lyricbridge/web build",
    "build:static": "pnpm --filter @lyricbridge/web build:static",
    "budget:static": "pnpm --filter @lyricbridge/web budget:static",
    "start": "pnpm --filter @lyricbridge/web start",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "e2e": "pnpm --filter @lyricbridge/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
